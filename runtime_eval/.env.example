# runtime_eval 配置示例（三服务）。复制为 runtime_eval/.env 后按需修改。
# eval-llm 与 eval-api 可共用本文件。
# ---------------------------------------------------------------------------

# ====================== eval-llm（大模型服务） ======================
# 选择 Provider：anthropic | llm_service | claude_cli | mock
# （兼容旧名 EVAL_LLM_BACKEND，作为回退）
EVAL_LLM_PROVIDER=mock

# ---- 方式一：Anthropic API 直连 ----
ANTHROPIC_API_KEY=
# 可选：自定义网关/代理地址（如使用中转）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
EVAL_ANTHROPIC_MODEL=claude-sonnet-4-5
EVAL_ANTHROPIC_MAX_TOKENS=4096

# ---- 方式二：复用仓库内 llm_service ----
EVAL_LLM_SERVICE_URL=http://localhost:8900
EVAL_LLM_SERVICE_CALLER=eval

# ---- 方式三：本机 Claude Code CLI（claude -p）----
# 复用已安装并登录好的 claude 命令做出题/裁判，本仓库无需配置任何 API Key。
# 前置：claude 已在 PATH 上（Windows 自动识别 claude.cmd）。
# EVAL_CLAUDE_BIN=claude              # 找不到时可填 claude 全路径
# EVAL_CLAUDE_MODEL=                  # 空=用 claude 自身默认模型；可填如 claude-sonnet-4-6
# EVAL_CLAUDE_TIMEOUT=600             # 单次调用超时(秒)，大文档出题可能较久
# EVAL_CLAUDE_EXTRA_ARGS=             # 追加给 claude 的原始参数，空格分隔

# ---- Agent 自动跑批（claude -p + 你自己的 MCP，自动检索知识库并作答）----
# 让 claude 挂上你现成的 MCP，按测试集逐题自动检索知识库 + 作答，
# 省去人工逐题「检索数据库」。前置同方式三（claude 已安装并登录）。
# 必填：指向你的 MCP 配置文件（claude --mcp-config 用的那种），否则跑批会报错。
# EVAL_AGENT_MCP_CONFIG=E:/path/to/your-mcp.json
# 只放行检索相关工具，避免 agent 乱用（逗号分隔；空=不限制）。
# 工具名形如 mcp__<服务名>__<工具名>，按你的 MCP 实际名字填。
# EVAL_AGENT_ALLOWED_TOOLS=mcp__kb__search
# 免确认放行工具调用（无人值守批跑用）：acceptEdits / bypassPermissions
# EVAL_AGENT_PERMISSION_MODE=bypassPermissions
# EVAL_AGENT_MODEL=                   # 空=用 claude 自身默认模型
# EVAL_AGENT_MAX_TURNS=0              # >0 才限制 agent 自循环步数
# EVAL_AGENT_TIMEOUT=600              # 单题超时(秒)，含多轮工具调用
# EVAL_AGENT_EXTRA_ARGS=              # 追加给 claude 的原始参数，空格分隔
# EVAL_AGENT_SYSTEM=                  # 自定义系统提示；空=用内置「先检索再作答」默认

# 出题温度（裁判恒为 0）
EVAL_TEMPERATURE=0.2

# ====================== eval-api（后端服务） ======================
# eval-api 调用 eval-llm 的地址
EVAL_LLM_URL=http://localhost:8801

# 出题 / 评测行为
EVAL_PER_TYPE=3
EVAL_PASS_THRESHOLD=0.6
EVAL_MAX_DOC_CHARS=24000

# HTTP / LLM 请求超时（秒）
EVAL_REQUEST_TIMEOUT=180

# 产物目录（一般无需改）
# EVAL_WORKSPACE_DIR=

# ---- 检索层·真实查询日志来源（serving_query_logs，只读，可选） ----
# 配齐 HOST/DBNAME/USER（+PASSWORD）后，可用
#   POST /api/v1/projects/{pid}/retrieval/live:evaluate
# 直接拉取被测检索器的真实流量做检索层评测（精确率族指标，无需黄金标注）。
# 不配置则该功能关闭，框架其余部分零 DB 依赖。
# SERVING_PG_HOST=
# SERVING_PG_PORT=5432
# SERVING_PG_DBNAME=
# SERVING_PG_USER=
# SERVING_PG_PASSWORD=
# SERVING_PG_SSLMODE=disable
