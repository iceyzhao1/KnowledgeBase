# telecom_eval local LLM judge configuration.
# Copy this file to telecom_eval/.env and fill in real API keys.

EVAL_ROSTER='[{"id":"claude-sonnet","label":"Claude Sonnet","channel":"claude_cli","model":"sonnet"},{"id":"deepseek-chat","label":"DeepSeek Chat","channel":"deepseek","model":"deepseek-chat"},{"id":"minimax-m2.7","label":"MiniMax M2.7","channel":"minimax","model":"MiniMax-M2.7"},{"id":"glm-5.2","label":"GLM-5.2","channel":"zhipu","model":"glm-5.2"}]'

EVAL_ANSWER_CHANNELS='{"deepseek":{"base_url":"https://api.deepseek.com","api_key":"YOUR_DEEPSEEK_API_KEY","type":"openai_compat"},"minimax":{"base_url":"YOUR_MINIMAX_BASE_URL","api_key":"YOUR_MINIMAX_API_KEY","type":"openai_compat"},"zhipu":{"base_url":"YOUR_ZHIPU_BASE_URL","api_key":"YOUR_ZHIPU_API_KEY","type":"openai_compat"}}'

# Optional. You can also pass --judge-model-id to the smoke script.
EVAL_JUDGE_MODEL_ID=deepseek-chat

# Optional request timeout in seconds.
EVAL_LLM_TIMEOUT=120
